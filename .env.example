# Copy to .env locally and on the server (~/nawaloka/.env). Never commit .env.

# LLM provider (Groq)
GROQ_API_KEY=

# Postgres connection string, ideally a read-only role
DATABASE_URL=postgresql://user:password@host:5432/dbname

# LangFuse tracing (optional, tracing is skipped when empty)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# HTTPS (server only). DOMAIN must point at the server's public IP.
# sslip.io gives a free hostname for any IP, for example nawaloka.16.176.5.126.sslip.io
DOMAIN=
LETSENCRYPT_EMAIL=
# Set to 1 to test against Let's Encrypt staging (browser shows an untrusted certificate)
LETSENCRYPT_STAGING=0

# Deployment values are not read from this file.
# Add them as secrets in the GitHub "production" environment:
# EC2_HOST=     public IP or DNS name of the EC2 instance
# EC2_USER=     ubuntu
# EC2_SSH_KEY=  full contents of the .pem key, including the BEGIN and END lines
